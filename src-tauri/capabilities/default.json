{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Write export files where the user pointed the save dialog, and nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
